@echo off
setlocal
set "CCM_RELEASE_DIR=%~dp0"
powershell.exe -NoLogo -NoProfile -Command "$env:PSModulePath=$PSHOME+'\Modules;'+$env:PSModulePath;$ErrorActionPreference='Stop';$core=Join-Path $env:CCM_RELEASE_DIR 'Codex-Control-MCP.exe';$shippedHost=Join-Path $env:CCM_RELEASE_DIR 'Codex-Control-MCP-Host.exe';$version=(& $core version|ConvertFrom-Json).version;if($LASTEXITCODE -ne 0 -or $version -notmatch '^\d+\.\d+\.\d+$'){throw 'Release version is unavailable'};$installed=Join-Path $env:LOCALAPPDATA ('Programs\Codex-Control-MCP\'+$version);$expectedHost=Join-Path $installed 'Codex-Control-MCP-Host.exe';$expectedCore=Join-Path $installed 'Codex-Control-MCP.exe';foreach($pair in @(@($core,$expectedCore),@($shippedHost,$expectedHost))){if(!(Test-Path -LiteralPath $pair[1]) -or (Get-FileHash -LiteralPath $pair[0] -Algorithm SHA256).Hash -ne (Get-FileHash -LiteralPath $pair[1] -Algorithm SHA256).Hash){throw 'Delivery does not match installed release; nothing started'}};$ownerHome=Join-Path $env:USERPROFILE '.codex-control-mcp';$ownerSid=[Security.Principal.WindowsIdentity]::GetCurrent().User.Value;$targets=@(@{Name='Codex-Control-MCP-OnDemand';Tail=' serve --transport streamable-http'},@{Name='Codex-Control-MCP-HTTPS-OnDemand';Tail=' tunnel'});$verified=@();foreach($target in $targets){$task=Get-ScheduledTask -TaskName $target.Name;$arguments='--home '+[char]34+$ownerHome+[char]34+$target.Tail;$principal=$task.Principal.UserId;if($principal -notmatch '^S-1-'){$principal=([Security.Principal.NTAccount]::new($principal)).Translate([Security.Principal.SecurityIdentifier]).Value};if(@($task.Actions).Count -ne 1 -or $task.Actions[0].Execute -ne $expectedHost -or $task.Actions[0].Arguments -ne $arguments -or @($task.Triggers|Where-Object{$null -ne $_}).Count -ne 0 -or $principal -ne $ownerSid -or $task.Principal.RunLevel -ne 'Highest'){throw 'Task ownership or configuration mismatch; nothing started'};$verified+=$task};foreach($task in $verified){if($task.State -ne 'Running'){Start-ScheduledTask -InputObject $task};Write-Output ('Owned manual service requested: '+$task.TaskName)};$deadline=[DateTime]::UtcNow.AddSeconds(30);do{$health=& $core status|ConvertFrom-Json;if($LASTEXITCODE -eq 0 -and $health.ok){Write-Output ('Codex-Control-MCP '+$version+' is ready.');exit 0};Start-Sleep -Milliseconds 500}while([DateTime]::UtcNow -lt $deadline);throw 'Service readiness timed out; use Check.cmd'"
if errorlevel 1 (
  echo Start failed. If Windows denied task access, run this launcher as administrator.
  exit /b 1
)
